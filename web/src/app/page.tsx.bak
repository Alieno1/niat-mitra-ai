"use client";

/**
 * @file src/app/page.tsx
 * @description Main dual-mode UI for NIAT TrustBridge AI:
 * - Tab 1: Parent & Student Vernacular Trust Portal (Intake -> Multi-Tool AI Agent -> Native Dossier & Chat -> Campus Visit Booking)
 * - Tab 2: Growth Manager Command Center (Live Neon Postgres CRM, CAT-A/CAT-B CAC Savings, 7-Day Window Tracker, WhatsApp & Tool Logs)
 */

import React, { useCallback, useEffect, useState } from "react";
import {
  Activity,
  AlertTriangle,
  BarChart3,
  Bot,
  CalendarCheck,
  Check,
  CheckCircle2,
  Copy,
  Cpu,
  Database,
  ExternalLink,
  Globe,
  KeyRound,
  MessageSquare,
  Mic,
  MicOff,
  Moon,
  Send,
  ShieldCheck,
  Sparkles,
  Square,
  Sun,
  TrendingUp,
  Volume2,
  X,
} from "lucide-react";

interface Campus {
  id: number;
  name: string;
  city: string;
  state: string;
  category: "CAT-A" | "CAT-B";
  affiliate_payout_inr: number;
  estimated_4yr_fee_lakhs: number;
  ugc_status: string;
  local_tier3_avg_lpa: number;
  slug: string;
}

interface Lead {
  id: number;
  student_name: string;
  parent_name: string;
  phone: string;
  state: string;
  city: string;
  exam_type: string;
  exam_rank: number;
  nat_score: number;
  budget_lakhs: number;
  preferred_language: string;
  primary_objection: string;
  matched_campus_id: number;
  campus_name?: string;
  campus_city?: string;
  campus_category?: string;
  campus_ugc?: string;
  trust_score: number;
  funnel_stage: string;
  open_market_expires_at: string;
  cac_saved_inr: number;
  created_at: string;
}

interface ToolTraceItem {
  tool_name: string;
  tool_input: Record<string, unknown>;
  tool_output: Record<string, unknown>;
  latency_ms: number;
}

interface DispatchItem {
  id: number;
  lead_id: number;
  student_name?: string;
  parent_name?: string;
  language: string;
  message_type: string;
  message_body: string;
  scheduled_visit_slot: string | null;
  status: string;
  created_at: string;
}

interface DashboardData {
  kpis: {
    total_leads: number;
    total_cac_saved_inr: number;
    avg_trust_score: number;
    cat_b_rescued: number;
    has_openrouter_key: boolean;
  };
  leads: Lead[];
  campuses: Campus[];
  toolLogs: Array<ToolTraceItem & { id: number; lead_id: number; created_at: string }>;
  dispatches: DispatchItem[];
}

const LANGUAGES = [
  "Telugu",
  "Hindi",
  "Tamil",
  "Kannada",
  "Malayalam",
  "Marathi",
  "Gujarati",
  "Punjabi",
  "Bengali",
  "Odia",
  "English",
];

/** Maps UI language names to BCP-47 Indian regional voice/speech locales */
const SPEECH_LOCALE_MAP: Record<string, string> = {
  Telugu: "te-IN",
  Hindi: "hi-IN",
  Tamil: "ta-IN",
  Kannada: "kn-IN",
  Malayalam: "ml-IN",
  Marathi: "mr-IN",
  Gujarati: "gu-IN",
  Punjabi: "pa-IN",
  Bengali: "bn-IN",
  Odia: "or-IN",
  English: "en-IN",
};

